generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            Int            @id @default(autoincrement())
  username      String         @unique
  password      String
  name          String
  role          Role
  createdAt     DateTime       @default(now()) @map("created_at")
  isActive      Boolean        @default(true) @map("is_active")
  activityLogs  ActivityLog[]
  cvConfigs     CvConfig[]
  sessions      Session[]
  inspections   Inspection[]
  refreshTokens RefreshToken[]

  @@index([username])
  @@index([role])
  @@map("User")
}

model RefreshToken {
  id        Int      @id @default(autoincrement())
  token     String   @unique
  userId    Int      @map("user_id")
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
  @@index([expiresAt])
  @@map("RefreshToken")
}

model Part {
  id          Int               @id @default(autoincrement())
  createdAt   DateTime          @default(now()) @map("created_at")
  partCode    String            @unique @map("part_code")
  partName    String            @map("part_name")
  vendorName  String            @map("vendor_name")
  batches     InspectionBatch[]
  inspections Inspection[]

  @@index([partCode])
  @@index([vendorName])
  @@map("Part")
}

model Session {
  id          Int               @id @default(autoincrement())
  endedAt     DateTime?         @map("ended_at")
  operatorId  Int               @map("operator_id")
  sessionId   String            @unique @map("session_id")
  startedAt   DateTime          @default(now()) @map("started_at")
  batches     InspectionBatch[]
  operator    User              @relation(fields: [operatorId], references: [id], onDelete: Cascade)
  inspections Inspection[]

  @@index([operatorId])
  @@index([sessionId])
  @@index([startedAt])
  @@map("Session")
}

model InspectionBatch {
  id            Int          @id @default(autoincrement())
  batchNumber   String       @unique @map("batch_number")
  createdAt     DateTime     @default(now()) @map("created_at")
  sessionId     String       @map("session_id")
  totalQuantity Int          @map("total_quantity")
  partId        Int          @map("part_id")
  part          Part         @relation(fields: [partId], references: [id])
  session       Session      @relation(fields: [sessionId], references: [sessionId], onDelete: Cascade)
  inspections   Inspection[]

  @@index([sessionId])
  @@index([partId])
  @@index([createdAt])
  @@map("InspectionBatch")
}

model Inspection {
  id           Int              @id @default(autoincrement())
  shape        String?          @db.VarChar(32)
  status       String           @db.VarChar(16)
  timestamp    DateTime         @default(now()) @db.Timestamptz(6)
  idPart       String?          @map("id_part") @db.VarChar(64)
  imagePath    String?          @map("image_path") @db.VarChar(256)
  matchedRef   String?          @map("matched_ref") @db.VarChar(128)
  nilaiDimensi Json?            @map("nilai_dimensi")
  batchId      Int?             @map("batch_id")
  operatorId   Int?             @map("operator_id")
  partId       Int              @map("part_id")
  sessionId    String?          @map("session_id")
  hash         String?          @db.VarChar(64)
  batch        InspectionBatch? @relation(fields: [batchId], references: [id])
  operator     User?            @relation(fields: [operatorId], references: [id])
  part         Part             @relation(fields: [partId], references: [id])
  session      Session?         @relation(fields: [sessionId], references: [sessionId])

  @@index([partId])
  @@index([operatorId])
  @@index([sessionId])
  @@index([batchId])
  @@index([status])
  @@index([timestamp])
  @@index([timestamp, status])
  @@map("inspeksi_log")
}


model CvConfig {
  id              Int      @id @default(autoincrement())
  pixelPerMm      Float    @default(9.28) @map("pixel_per_mm")
  toleranceMm     Float    @default(1.0)  @map("tolerance_mm")
  contourThresh   Int      @default(200)  @map("contour_thresh")
  contourMinArea  Int      @default(1500) @map("contour_min_area")
  minFeatureMm    Float    @default(5.0)  @map("min_feature_mm")
  roiPercent      Json     @default("[0.20, 0.10, 0.80, 0.90]") @map("roi_percent")
  warningDuration Float    @default(5.0)  @map("warning_duration")
  updatedAt       DateTime @updatedAt     @map("updated_at")
  updatedBy       Int      @map("updated_by")
  updatedByUser   User     @relation(fields: [updatedBy], references: [id])

  @@map("cv_config")
}
model ActivityLog {
  id        Int      @id @default(autoincrement())
  action    String
  detail    String?
  createdAt DateTime @default(now()) @map("created_at")
  userId    Int      @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([createdAt])
  @@index([action])
  @@map("ActivityLog")
}

enum Role {
  OPERATOR_QC
  ENGINEER
  QUALITY_MANAGER
  AUDIT
  ADMIN
}



